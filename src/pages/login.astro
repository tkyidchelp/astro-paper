---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import config from "@/config";
---

<Layout title={`登录 | ${config.site.title}`}>
  <Header />
  <Breadcrumb />
  <Main pageTitle="登录" class="app-prose">
    <div class="mx-auto max-w-sm space-y-4">
      <input id="login-name" type="text" placeholder="用户名" class="border-border bg-background w-full rounded-md border px-3 py-2 text-sm outline-none focus:border-accent" />
      <input id="login-pass" type="password" placeholder="密码" class="border-border bg-background w-full rounded-md border px-3 py-2 text-sm outline-none focus:border-accent" />

      <div id="code-section" class="hidden space-y-3">
        <div class="flex gap-2">
          <input id="login-code" type="text" placeholder="邮箱验证码" class="border-border bg-background flex-1 rounded-md border px-3 py-2 text-sm outline-none focus:border-accent" />
          <button id="send-code-btn" class="bg-accent text-background shrink-0 rounded-md px-3 py-2 text-xs font-medium hover:opacity-80 whitespace-nowrap">发送验证码</button>
        </div>
        <p id="masked-email" class="text-xs text-muted text-center"></p>
      </div>

      <button id="login-btn" class="bg-accent text-background w-full rounded-md px-4 py-2 text-sm font-medium hover:opacity-80">登录</button>
      <p id="login-msg" class="text-sm text-center"></p>
      <p class="text-muted text-sm text-center">没有账号？<a href="/register/" class="text-accent underline">注册</a> | <a href="/forgot-password/" class="text-accent underline">忘记密码</a></p>
    </div>
  </Main>
  <Footer />
</Layout>

<script is:inline>
function initLogin() {
  var btn = document.getElementById("login-btn");
  var msg = document.getElementById("login-msg");
  var codeSection = document.getElementById("code-section");
  var sendBtn = document.getElementById("send-code-btn");
  var maskedEmail = document.getElementById("masked-email");

  if (!btn || !msg || !codeSection || !sendBtn || !maskedEmail) return;

  var needCode = false;
  var emailForCode = "";

  sendBtn.addEventListener("click", function() {
    sendBtn.disabled = true;
    sendBtn.textContent = "发送中...";

    fetch("/api/auth/send-code", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ email: emailForCode })
    })
      .then(function(r) { return r.json(); })
      .then(function(d) {
        if (d.error) {
          msg.textContent = d.error;
          msg.className = "text-sm text-center text-red-500";
          sendBtn.disabled = false;
          sendBtn.textContent = "发送验证码";
          return;
        }
        msg.textContent = "验证码已发送";
        msg.className = "text-sm text-center text-green-500";
        sendBtn.textContent = "已发送";
        setTimeout(function() {
          sendBtn.textContent = "重新发送";
          sendBtn.disabled = false;
        }, 60000);
      })
      .catch(function() {
        msg.textContent = "网络错误";
        msg.className = "text-sm text-center text-red-500";
        sendBtn.disabled = false;
        sendBtn.textContent = "发送验证码";
      });
  });

  btn.addEventListener("click", function() {
    var name = document.getElementById("login-name").value.trim();
    var pass = document.getElementById("login-pass").value.trim();

    if (!name || !pass) { msg.textContent = "请填写用户名和密码"; msg.className = "text-sm text-center text-red-500"; return; }

    msg.textContent = "登录中...";
    msg.className = "text-sm text-center text-muted";

    var codeEl = document.getElementById("login-code");
    var code = codeEl ? codeEl.value.trim() : "";

    fetch("/api/auth/login", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ username: name, password: pass, code: needCode ? code : undefined })
    })
      .then(function(r) { return r.json(); })
      .then(function(d) {
        if (d.needCode) {
          needCode = true;
          emailForCode = d.maskedEmail;
          codeSection.classList.remove("hidden");
          maskedEmail.textContent = "验证码将发送至: " + d.maskedEmail;
          msg.textContent = "请输入邮箱验证码";
          msg.className = "text-sm text-center text-muted";
          btn.textContent = "验证并登录";
          return;
        }

        if (d.error) { msg.textContent = d.error; msg.className = "text-sm text-center text-red-500"; return; }
        localStorage.setItem("blog-token", d.token);
        localStorage.setItem("blog-user", d.username);
        if (d.createdAt) localStorage.setItem("blog-created", d.createdAt);
        msg.textContent = "登录成功";
        msg.className = "text-sm text-center text-green-500";
        setTimeout(function() { window.location.href = "/"; }, 500);
      })
      .catch(function() { msg.textContent = "网络错误"; msg.className = "text-sm text-center text-red-500"; });
  });
}
initLogin();
</script>
