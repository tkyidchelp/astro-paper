---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import config from "@/config";
---

<Layout title={`忘记密码 | ${config.site.title}`}>
  <Header />
  <Breadcrumb />
  <Main pageTitle="忘记密码" class="app-prose">
    <div class="mx-auto max-w-sm space-y-4">
      <input id="fp-email" type="email" placeholder="注册邮箱" class="border-border bg-background w-full rounded-md border px-3 py-2 text-sm outline-none focus:border-accent" />
      <div id="fp-code-section" class="hidden space-y-3">
        <div class="flex gap-2">
          <input id="fp-code" type="text" placeholder="验证码" class="border-border bg-background flex-1 rounded-md border px-3 py-2 text-sm outline-none focus:border-accent" />
          <button id="fp-send" class="bg-accent text-background shrink-0 rounded-md px-3 py-2 text-xs font-medium hover:opacity-80 whitespace-nowrap">发送验证码</button>
        </div>
        <input id="fp-newpass" type="password" placeholder="新密码（至少6位）" class="border-border bg-background w-full rounded-md border px-3 py-2 text-sm outline-none focus:border-accent" />
        <input id="fp-newpass2" type="password" placeholder="确认新密码" class="border-border bg-background w-full rounded-md border px-3 py-2 text-sm outline-none focus:border-accent" />
      </div>
      <button id="fp-btn" class="bg-accent text-background w-full rounded-md px-4 py-2 text-sm font-medium hover:opacity-80">下一步</button>
      <div class="cf-turnstile" data-sitekey="0x4AAAAAAD97tzDDAk6cBcmK" data-theme="auto"></div>
      <p id="fp-msg" class="text-sm text-center"></p>
      <p class="text-muted text-sm text-center"><a href="/login/" class="text-accent underline">返回登录</a></p>
    </div>
  </Main>
  <Footer />
</Layout>

<script is:inline>
var step = 0;

function m(s, c) {
  var el = document.getElementById("fp-msg");
  if (el) { el.textContent = s; el.className = "text-sm text-center " + c; }
}

function initFp() {
document.getElementById("fp-btn")?.addEventListener("click", async function() {
  var email = document.getElementById("fp-email").value.trim();
  if (!email || !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { m("请输入有效邮箱", "text-red-500"); return; }

  if (step === 0) {
    var tsEl = document.querySelector('[name="cf-turnstile-response"]');
    var tsToken = tsEl ? tsEl.value : "";
    if (!tsToken) { m("请完成人机验证", "text-red-500"); return; }
    m("发送中...", "text-muted");
    try {
      var r = await fetch("/api/auth/reset-password", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email: email, turnstile: tsToken })
      });
      var d = await r.json();
      if (d.error) { m(d.error, "text-red-500"); return; }
      step = 1;
      document.getElementById("fp-code-section")?.classList.remove("hidden");
      var fpBtn = document.getElementById("fp-btn"); if (fpBtn) fpBtn.textContent = "重置密码";
      var fpEmail = document.getElementById("fp-email"); if (fpEmail) fpEmail.disabled = true;
      m("验证码已发送至 " + d.maskedEmail, "text-green-500");
    } catch { m("网络错误", "text-red-500"); }
    return;
  }

  var code = document.getElementById("fp-code").value.trim();
  var p1 = document.getElementById("fp-newpass").value;
  var p2 = document.getElementById("fp-newpass2").value;
  if (!code) { m("请输入验证码", "text-red-500"); return; }
  if (p1.length < 6) { m("密码至少6位", "text-red-500"); return; }
  if (p1 !== p2) { m("两次密码不一致", "text-red-500"); return; }

  m("重置中...", "text-muted");
  try {
    var r = await fetch("/api/auth/reset-password", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ email: email, code: code, newPassword: p1 })
    });
    var d = await r.json();
    if (d.error) { m(d.error, "text-red-500"); return; }
    m("密码重置成功", "text-green-500");
    setTimeout(function() { window.location.href = "/login/"; }, 1000);
  } catch { m("网络错误", "text-red-500"); }
});

document.getElementById("fp-send")?.addEventListener("click", async function() {
  var btn = document.getElementById("fp-send");
  var email = document.getElementById("fp-email").value.trim();
  if (!email) { m("请输入邮箱", "text-red-500"); return; }
  btn.disabled = true;
  btn.textContent = "发送中...";
  try {
    var r = await fetch("/api/auth/reset-password", {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: JSON.stringify({ email: email })
    });
    var d = await r.json();
    if (d.error) { m(d.error, "text-red-500"); btn.disabled = false; btn.textContent = "发送验证码"; return; }
    m("验证码已发送", "text-green-500");
    btn.textContent = "已发送";
    setTimeout(function() { btn.textContent = "重新发送"; btn.disabled = false; }, 60000);
  } catch { m("网络错误", "text-red-500"); btn.disabled = false; btn.textContent = "发送验证码"; }
});
}

initFp();
document.addEventListener("astro:after-swap", initFp);
</script>

<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
