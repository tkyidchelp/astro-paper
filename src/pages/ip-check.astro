---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import config from "@/config";

const pageTitle = "IP 纯度测试";
---

<Layout title={`${pageTitle} | ${config.site.title}`}>
  <Header />
  <Breadcrumb />
  <Main pageTitle={pageTitle} class="app-prose">
    <p class="text-muted mb-6 text-sm">
      检测 IP 地址的纯净度，包括归属地、ISP、是否被标记为代理/VPN/数据中心等。
    </p>

    <div id="ip-check-app" class="space-y-4">
      <div class="flex gap-2">
        <input
          id="ip-input"
          type="text"
          placeholder="输入 IP 地址查询，留空检测当前 IP"
          class="border-border bg-background flex-1 rounded-md border px-3 py-2 text-sm outline-none focus:border-accent"
        />
        <button
          id="ip-btn"
          class="bg-accent text-background rounded-md px-4 py-2 text-sm font-medium hover:opacity-80 transition-opacity"
        >
          检测
        </button>
      </div>
      <div id="ip-result" class="text-muted text-sm" />
    </div>
  </Main>
  <Footer />
</Layout>

<script is:inline>
function initIpCheck() {
  var input = document.getElementById("ip-input");
  var btn = document.getElementById("ip-btn");
  var result = document.getElementById("ip-result");
  if (!input || !btn || !result) return;

  function checkIp() {
    var ip = input.value.trim();
    result.innerHTML = '<span>查询中...</span>';

    var url = "https://ipwhois.app/json/" + (ip || "");
    fetch(url)
      .then(function(res) { return res.json(); })
      .then(function(data) {
        if (!data.success) {
          result.innerHTML = '<p class="text-red-500">查询失败</p>';
          return;
        }
        result.innerHTML = renderResult(data);
      })
      .catch(function() {
        result.innerHTML = '<p class="text-red-500">网络请求失败</p>';
      });
  }

  function renderResult(d) {
    var score = 100;
    var warnings = [];
    var org = (d.org || "").toLowerCase();
    if (org.indexOf("cloud") >= 0 || org.indexOf("hosting") >= 0) { score -= 30; warnings.push("云服务/托管"); }
    if (org.indexOf("google") >= 0) { score -= 15; warnings.push("Google"); }
    if (org.indexOf("cloudflare") >= 0) { score -= 10; warnings.push("CDN"); }
    if (org.indexOf("amazon") >= 0) { score -= 20; warnings.push("AWS"); }
    if (org.indexOf("microsoft") >= 0) { score -= 20; warnings.push("微软云"); }
    if (org.indexOf("digitalocean") >= 0) { score -= 25; warnings.push("VPS"); }
    if (score < 0) score = 0;

    var color = score >= 80 ? "text-green-500" : score >= 50 ? "text-yellow-500" : "text-red-500";
    var label = score >= 80 ? "纯净" : score >= 50 ? "可疑" : "高风险";

    return '<table class="w-full text-sm"><tbody class="divide-y divide-border">' +
      '<tr><td class="py-2 pr-4 font-medium whitespace-nowrap">IP</td><td class="py-2">' + d.ip + '</td></tr>' +
      '<tr><td class="py-2 pr-4 font-medium whitespace-nowrap">地区</td><td class="py-2">' + d.country + ' ' + (d.region || "") + ' ' + (d.city || "") + '</td></tr>' +
      '<tr><td class="py-2 pr-4 font-medium whitespace-nowrap">ISP</td><td class="py-2">' + d.isp + '</td></tr>' +
      '<tr><td class="py-2 pr-4 font-medium whitespace-nowrap">组织</td><td class="py-2">' + (d.org || "--") + '</td></tr>' +
      '<tr><td class="py-2 pr-4 font-medium whitespace-nowrap">ASN</td><td class="py-2">' + (d.asn || "--") + '</td></tr>' +
      '<tr><td class="py-2 pr-4 font-medium whitespace-nowrap">坐标</td><td class="py-2">' + d.latitude + ', ' + d.longitude + '</td></tr>' +
      '<tr><td class="py-2 pr-4 font-medium whitespace-nowrap">时区</td><td class="py-2">' + (d.timezone || "--") + '</td></tr>' +
      '<tr class="bg-muted/50"><td class="py-3 pr-4 font-bold whitespace-nowrap">纯净度</td><td class="py-3">' +
      '<span class="' + color + ' text-lg font-bold">' + score + ' 分</span>' +
      '<span class="ml-2 px-2 py-0.5 rounded text-xs font-medium ' + color + ' bg-current/10">' + label + '</span>' +
      (warnings.length ? '<span class="ml-2 text-xs text-muted">(' + warnings.join(", ") + ')</span>' : "") +
      '</td></tr></tbody></table>';
  }

  btn.addEventListener("click", checkIp);
  input.addEventListener("keydown", function(e) { if (e.key === "Enter") checkIp(); });
  checkIp();
}

initIpCheck();
document.addEventListener("astro:after-swap", initIpCheck);
</script>
