---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Breadcrumb from "@/components/Breadcrumb.astro";
import Main from "@/components/Main.astro";
import config from "@/config";
---

<Layout title={`文章 | ${config.site.title}`}>
  <Header />
  <Breadcrumb />
  <Main pageTitle="" class="app-prose">
    <div id="post-loading" class="text-center py-12"><p class="text-muted">加载中...</p></div>
    <article id="post-content" class="hidden">
      <h1 id="post-title" class="text-3xl font-bold mb-2"></h1>
      <div class="flex gap-3 text-sm text-muted mb-6">
        <span id="post-date"></span>
        <span id="post-tags"></span>
      </div>
      <div id="post-body" class="prose dark:prose-invert max-w-none"></div>
    </article>
    <div id="post-error" class="hidden text-center py-12">
      <p class="text-red-500">文章未找到</p>
      <a href="/posts/" class="text-accent underline">返回文章列表</a>
    </div>
  </Main>
  <Footer />
</Layout>

<script is:inline>
function render() {
  var slug = new URLSearchParams(window.location.search).get("slug");
  if (!slug) {
    var path = window.location.pathname.replace(/\/$/, "");
    slug = path.split("/").pop();
  }
  if (!slug) {
    document.getElementById("post-loading")?.classList.add("hidden");
    document.getElementById("post-error")?.classList.remove("hidden");
    return;
  }

  fetch("/api/admin/posts?slug=" + encodeURIComponent(slug))
    .then(function(r) { return r.json(); })
    .then(function(post) {
      document.getElementById("post-loading")?.classList.add("hidden");
      if (post.error) { document.getElementById("post-error")?.classList.remove("hidden"); return; }

      document.title = post.title + " | 杨宏轩的个人博客";
      var pt = document.getElementById("post-title"); if (pt) pt.textContent = post.title;
      var pd = document.getElementById("post-date"); if (pd) pd.textContent = post.pubDatetime ? new Date(post.pubDatetime).toLocaleDateString("zh-CN") : "";
      if (post.tags && post.tags.length) {
        var ptag = document.getElementById("post-tags"); if (ptag) ptag.textContent = post.tags.map(function(t) { return "#" + t; }).join(" ");
      }

      var body = document.getElementById("post-body");
      if (body && post.content) {
        var lines = post.content.split("\n");
        var html = "";
        var inCode = false;
        for (var i = 0; i < lines.length; i++) {
          var line = lines[i];
          if (line.startsWith("```")) {
            inCode = !inCode;
            html += inCode ? '<pre class="bg-card rounded-lg p-4 overflow-x-auto"><code>' : '</code></pre>';
            continue;
          }
          if (inCode) { html += line + "\n"; continue; }
          if (line.startsWith("# ")) html += '<h1 class="text-2xl font-bold mt-8 mb-4">' + line.slice(2) + '</h1>';
          else if (line.startsWith("## ")) html += '<h2 class="text-xl font-semibold mt-6 mb-3">' + line.slice(3) + '</h2>';
          else if (line.startsWith("### ")) html += '<h3 class="text-lg font-semibold mt-5 mb-2">' + line.slice(4) + '</h3>';
          else if (line.startsWith("- ")) html += '<li>' + line.slice(2) + '</li>';
          else if (line.startsWith("![](")) {
            var m = line.match(/!\[(.*?)\]\((.*?)\)/);
            if (m) html += '<img src="' + m[2] + '" alt="' + m[1] + '" class="rounded-lg my-4 max-w-full">';
          } else if (line.match(/\[(.*?)\]\((.*?)\)/)) {
            html += line.replace(/\[(.*?)\]\((.*?)\)/g, '<a href="$2" class="text-accent underline">$1</a>') + '<br>';
          } else if (line.trim() === "") html += '<br>';
          else if (line.startsWith("> ")) html += '<blockquote class="border-l-4 border-accent pl-4 italic text-muted">' + line.slice(2) + '</blockquote>';
          else html += '<p>' + line + '</p>';
        }
        body.innerHTML = html;
      }

      document.getElementById("post-content")?.classList.remove("hidden");
    })
    .catch(function() {
      document.getElementById("post-loading")?.classList.add("hidden");
      document.getElementById("post-error")?.classList.remove("hidden");
    });
}

render();
</script>
