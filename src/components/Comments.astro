---
const REPO = "tkyidchelp/astro-paper";
const ISSUE_TERM = "pathname";
const THEME = "preferred-color-scheme";
---

<section>
  <div
    id="utterances-comments"
    class="mt-12"
    data-repo={REPO}
    data-issue-term={ISSUE_TERM}
    data-theme={THEME}
    data-label="comment"
  />
</section>

<script is:inline>
  function loadUtterances() {
    const el = document.getElementById("utterances-comments");
    if (!el || document.querySelector("script[src*='utteranc.es']")) return;

    const script = document.createElement("script");
    script.src = "https://utteranc.es/client.js";
    script.setAttribute("repo", el.dataset.repo || "tkyidchelp/astro-paper");
    script.setAttribute("issue-term", el.dataset.issueTerm || "pathname");
    script.setAttribute("theme", el.dataset.theme || "preferred-color-scheme");
    script.setAttribute("label", el.dataset.label || "comment");
    script.crossOrigin = "anonymous";
    script.async = true;
    el.appendChild(script);
  }

  loadUtterances();

  document.addEventListener("astro:after-swap", () => {
    const old = document.querySelector("script[src*='utteranc.es']");
    if (old) old.remove();
    const el = document.getElementById("utterances-comments");
    if (el) el.innerHTML = "";
    loadUtterances();
  });

  function syncTheme() {
    const iframe = document.querySelector<HTMLIFrameElement>(".utterances-frame");
    if (!iframe?.contentWindow) return;
    const theme = document.documentElement.classList.contains("dark") ? "github-dark" : "github-light";
    iframe.contentWindow.postMessage({ type: "set-theme", theme }, "https://utteranc.es");
  }

  const observer = new MutationObserver(() => syncTheme());
  observer.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
  document.addEventListener("astro:after-swap", () => setTimeout(syncTheme, 300));
</script>
